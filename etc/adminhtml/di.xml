<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
        Inject a "Reindex" mass action + "Reindex All" button into the
        stock Index Management grid. Plugging beforeToHtml gives us a
        chance to add to the massaction block AFTER Magento has built it
        in _prepareLayout but BEFORE the HTML is rendered.
    -->
    <type name="Magento\Indexer\Block\Backend\Grid">
        <plugin name="etechflow_admin_reindex_inject_actions"
                type="Etechflow\AdminReindex\Plugin\IndexerGridPlugin"
                sortOrder="100"/>
    </type>
</config>
